# Copy to .env. Scripts automatically load .env if present.
# Local demo needs no configuration. Never expose demo mode to a network.
KNOWLEDGE_MODE=demo
PORT=3001
HOST=127.0.0.1
KNOWLEDGE_DATA_DIR=.data
# The first workspace (keeps the original single-repository layout).
# KNOWLEDGE_DEFAULT_WORKSPACE=engineering
# KNOWLEDGE_DEFAULT_WORKSPACE_NAME=Engineering

# Production: dedicated remote repository with service-account write access.
# KNOWLEDGE_MODE=production
# KNOWLEDGE_REMOTE=ssh://git@git.internal/engineering/knowledge.git
# Workspaces created by users: an existing (possibly empty) repository per slug.
# Without it, the service keeps a bare repository per workspace under the data directory.
# KNOWLEDGE_WORKSPACE_REMOTE_TEMPLATE=ssh://git@git.internal/knowledge/{slug}.git
# KNOWLEDGE_BRANCH=main
# KNOWLEDGE_ROOT_OWNER=sunho
# KNOWLEDGE_USERS_FILE=/etc/knowledge-wiki/users.json
# KNOWLEDGE_ORIGIN=https://knowledge.internal
# KNOWLEDGE_PROXY_SECRET=replace-with-at-least-32-random-characters
# KNOWLEDGE_MCP_TOKEN=replace-with-a-different-random-token-of-at-least-32-characters
# HOST=0.0.0.0
